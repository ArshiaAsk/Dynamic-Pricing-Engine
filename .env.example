 # Dynamic Pricing Engine - Environment Configuration Template
 # Copy this file to .env and fill in your values
 
 # Application Settings
 APP_ENV=production
 APP_NAME=Dynamic Pricing Engine
 APP_VERSION=1.0.0
 DEBUG=false
 
 # API Configuration
 API_HOST=0.0.0.0
 API_PORT=8000
 API_WORKERS=4
 API_RELOAD=false
 
 # CORS Settings (comma-separated origins)
 CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
 CORS_ALLOW_CREDENTIALS=true
 
 # Rate Limiting
 RATE_LIMIT_ENABLED=true
 RATE_LIMIT_REQUESTS=100
 RATE_LIMIT_WINDOW=60
 
 # Database
 DATABASE_URL=sqlite:///./data.db
 DATABASE_BACKUP_ENABLED=true
 DATABASE_BACKUP_INTERVAL=86400
 DATABASE_BACKUP_RETENTION_DAYS=7
 
 # Model Configuration
 MODEL_PATH=models/demand_model.pkl
 FEATURES_PATH=models/features.json
 MODEL_CACHE_ENABLED=true
 MODEL_RELOAD_INTERVAL=3600
 
 # Logging
 LOG_LEVEL=INFO
 LOG_FORMAT=json
 LOG_DIR=logs
 LOG_ROTATION=daily
 LOG_RETENTION_DAYS=30
 
 # Monitoring
 MONITORING_ENABLED=true
 METRICS_ENABLED=true
 HEALTH_CHECK_INTERVAL=60
 
 # Prediction Logging
 PREDICTION_LOG_ENABLED=true
 PREDICTION_LOG_DIR=logs/predictions
 PREDICTION_LOG_BATCH_SIZE=100
 
 # Performance
 REQUEST_TIMEOUT=30
 MODEL_INFERENCE_TIMEOUT=5
 CACHE_TTL=300
 
 # AWS Configuration (for deployment)
 AWS_REGION=us-east-1
 AWS_ACCESS_KEY_ID=
 AWS_SECRET_ACCESS_KEY=
 
 # Alerts & Notifications
 ALERT_EMAIL=
 ALERT_WEBHOOK_URL=
 ALERT_ERROR_THRESHOLD=0.05
 
 # MLflow (optional)
 MLFLOW_TRACKING_URI=http://localhost:5000
 MLFLOW_EXPERIMENT_NAME=dynamic-pricing
