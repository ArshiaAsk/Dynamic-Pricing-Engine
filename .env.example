# Dynamic Pricing Engine — environment variables read by src/ code.
#
# Copy this file to `.env` and adjust. Every variable listed here is read by
# the application (ROADMAP R19 / CONVENTIONS rule 6); decorative variables that
# nothing reads are intentionally absent.

# Application environment. Selects configs/config.<env>.yaml in EnvConfig
# (production|prod -> config.prod.yaml, development|dev -> config.dev.yaml).
APP_ENV=production

# API server — src/api/server.py
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# CORS — src/api/server.py
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate limiting — src/api/server.py
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100

# Per-request timeout in seconds — src/api/server.py
REQUEST_TIMEOUT=30

# Logging — src/api/server.py -> src/utils/logger.py
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=logs
# File rotation (ROADMAP R20): 'size' | 'daily' | 'none'.
# LOG_MAX_BYTES applies to 'size'; LOG_BACKUP_COUNT is kept for both modes.
LOG_ROTATION=daily
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=30

# MLflow tracking URI — src/pricing/engine.py (optional; the engine falls back
# to the local model artifact models/demand_model.pkl when no registry is up).
MLFLOW_TRACKING_URI=http://localhost:5000
